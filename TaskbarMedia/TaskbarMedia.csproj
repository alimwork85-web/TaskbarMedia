<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The app starts as WPF, which reads its DPI awareness from app.manifest; this WinForms check does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskbarMedia</RootNamespace>
    <AssemblyName>TaskbarMedia</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Shown in the EXE's Properties > Details. -->
    <Version>1.1.0</Version>
    <Product>TaskbarMedia</Product>
    <AssemblyTitle>TaskbarMedia</AssemblyTitle>
    <Description>Floating media island for Windows 11</Description>
    <Authors>Ali Alhumedi</Authors>
    <Company>Ali Alhumedi</Company>
    <Copyright>© 2026 Ali Alhumedi</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its names out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="app.ico" />
    <Resource Include="tray-light.ico" />
    <Resource Include="tray-dark.ico" />
    <Resource Include="Fonts\Amiri-Regular.ttf" />
    <Resource Include="Fonts\IBMPlexSansArabic-Regular.ttf" />
    <Resource Include="Fonts\IBMPlexSansArabic-SemiBold.ttf" />
    <Resource Include="Fonts\TaskbarMediaUI.CompositeFont" />
  </ItemGroup>

</Project>
