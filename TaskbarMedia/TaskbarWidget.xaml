<Window x:Class="TaskbarMedia.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarMedia"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <!-- A single taskbar-sized button showing the current cover (like the tray chevron). -->
    <Border x:Name="Root" Width="40" Height="40" CornerRadius="4" Background="Transparent">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="خروج" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Cover art, with a music-note placeholder underneath -->
        <Grid x:Name="CoverGrid" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border CornerRadius="4">
                <Border.Background>
                    <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
        </Grid>
    </Border>
</Window>
