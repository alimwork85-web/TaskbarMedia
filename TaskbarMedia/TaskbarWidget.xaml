<Window x:Class="TaskbarMedia.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarMedia"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <!-- A single taskbar-sized button showing the current cover (like the tray chevron). -->
    <Border x:Name="Root" Width="40" Height="40" CornerRadius="4" Background="Transparent">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="PositionMenu" Header="الموضع">
                    <MenuItem Tag="Auto" Header="تلقائي" IsCheckable="True" Click="Position_Click"/>
                    <MenuItem Tag="TopLeft" Header="أعلى اليسار" IsCheckable="True" Click="Position_Click"/>
                    <MenuItem Tag="TopCenter" Header="أعلى الوسط" IsCheckable="True" Click="Position_Click"/>
                    <MenuItem Tag="TopRight" Header="أعلى اليمين" IsCheckable="True" Click="Position_Click"/>
                    <MenuItem Tag="BottomLeft" Header="أسفل اليسار" IsCheckable="True" Click="Position_Click"/>
                    <MenuItem Tag="BottomRight" Header="أسفل اليمين" IsCheckable="True" Click="Position_Click"/>
                </MenuItem>
                <MenuItem Header="شكل اللوحة">
                    <MenuItem x:Name="ShapeNormalItem" Header="عادي" IsCheckable="True" Click="ShapeNormal_Click"/>
                    <MenuItem x:Name="ShapeCapsuleItem" Header="كبسولة" IsCheckable="True" Click="ShapeCapsule_Click"/>
                </MenuItem>
                <MenuItem x:Name="HideFullscreenItem" Header="إخفاء في وضع ملء الشاشة" IsCheckable="True" Click="HideFullscreen_Click"/>
                <MenuItem x:Name="AutoShowItem" Header="إظهار تلقائي عند تغيير الأغنية" IsCheckable="True" Click="AutoShow_Click"/>
                <MenuItem x:Name="HotkeyItem" Header="تفعيل الاختصار" IsCheckable="True" Click="Hotkey_Click"/>
                <MenuItem Header="لون التمييز">
                    <MenuItem x:Name="AccentAlbumItem" Header="لون الألبوم" IsCheckable="True" Click="AccentAlbum_Click"/>
                    <MenuItem x:Name="AccentWindowsItem" Header="لون ويندوز" IsCheckable="True" Click="AccentWindows_Click"/>
                </MenuItem>
                <MenuItem Header="خروج" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <!-- Cover art, with a music-note placeholder underneath -->
        <Grid x:Name="CoverGrid" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border CornerRadius="4">
                <Border.Background>
                    <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
        </Grid>
    </Border>
</Window>
