<Window x:Class="TaskbarMedia.NowPlayingPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskbarMedia"
        Title="TaskbarMedia Now Playing"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}">

    <!-- Outer margin leaves room for the shadow. -->
    <Border x:Name="Root" Margin="16" CornerRadius="10" Padding="20" BorderThickness="1" Width="460">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Direction="270"/>
        </Border.Effect>

        <!-- Wide layout: cover on the leading side (right in RTL, left in LTR), controls in a column beside it. -->
        <Grid x:Name="Inner">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- "Disc" style: the cover as a spinning record; its ring is the seek bar (click or drag on it) -->
            <local:Disc x:Name="DiscCover" Grid.Column="0" Width="150" Height="150" RingThickness="4" RingGap="5" HoleScale="0.3333"
                        VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                        MouseLeftButtonDown="Seek_MouseDown" MouseMove="Seek_MouseMove" MouseLeftButtonUp="Seek_MouseUp" MouseLeave="Disc_MouseLeave"/>

            <!-- "Ribbon" style: a tall strip of the cover, with a music-note placeholder underneath -->
            <Grid x:Name="SquareCover" Grid.Column="0" Width="120" MinHeight="160">
                <Border CornerRadius="10" Background="#33808080">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="64"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                </Border>
                <Border CornerRadius="10">
                    <Border.Background>
                        <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <!-- The previous song's cover, fading out over the new one -->
                <Border x:Name="OldCover" CornerRadius="10" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <ImageBrush x:Name="OldCoverBrush" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <!-- Title and artist swap rows by style: the "Ribbon" title sits under the artist, large, in Amiri -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <local:MarqueeText x:Name="TitleText" Margin="0" CenterWhenFits="True"
                                   TextElement.FontSize="17" TextElement.FontWeight="SemiBold"/>
                <local:MarqueeText x:Name="ArtistText" Grid.Row="1" Margin="0,4,0,0" CenterWhenFits="True"
                                   TextElement.FontSize="13" Opacity="0.7"/>
            </Grid>

            <!-- Seek bar: click or drag to jump anywhere in the track -->
            <StackPanel x:Name="SeekArea" Width="240" Margin="0,12,0,0" FlowDirection="LeftToRight">
                <Grid x:Name="SeekBar" Height="16" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Seek_MouseDown" MouseMove="Seek_MouseMove" MouseLeftButtonUp="Seek_MouseUp">
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Opacity="0.25"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Border x:Name="SeekFill" Height="4" Width="0" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Ellipse x:Name="SeekThumb" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
                <Grid x:Name="TimesRow" Opacity="0.7" Margin="0,2,0,0">
                    <TextBlock x:Name="ElapsedText" FontSize="11" Text="0:00" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="DurationText" FontSize="11" Text="0:00" HorizontalAlignment="Right"/>
                </Grid>
                <!-- "Disc" style: one centered line, tabular digits so it doesn't shake as it counts -->
                <TextBlock x:Name="TimeText" FontSize="11" Opacity="0.7" Text="0:00 / 0:00" HorizontalAlignment="Center"
                           Typography.NumeralAlignment="Tabular"/>
            </StackPanel>

            <StackPanel x:Name="ControlsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <!-- A small dot under shuffle/repeat marks "on" (not just the color) -->
                <Grid>
                    <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Width="44" Height="44" Content="&#xE8B1;" Click="Shuffle_Click"/>
                    <Ellipse x:Name="ShuffleDot" Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,6" IsHitTestVisible="False" Visibility="Hidden"/>
                </Grid>
                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Width="44" Height="44" FontSize="17" Content="&#xF8AC;" Click="Prev_Click"/>
                <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="52" Height="52" FontSize="24" Content="&#xF5B0;" Click="PlayPause_Click"/>
                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Width="44" Height="44" FontSize="17" Content="&#xF8AD;" Click="Next_Click"/>
                <Grid>
                    <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Width="44" Height="44" Content="&#xE8EE;" Click="Repeat_Click"/>
                    <Ellipse x:Name="RepeatDot" Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,6" IsHitTestVisible="False" Visibility="Hidden"/>
                </Grid>
            </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
